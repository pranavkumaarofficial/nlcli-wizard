# ---------------------------------------------------------------------------
# nlcli-wizard .gitignore
# Principle: source, datasets, docs, and eval results are tracked.
# Model weights, build artifacts, and private notes are not.
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
venv/
env/
ENV/
.venv/

# --- Model weights & training artifacts (host on HuggingFace, not git) ---
models/
*.gguf
*.bin
*.safetensors
*.pth
*.dat
*_lora/
*_merged/
outputs/
checkpoints/
imatrix_data.txt

# --- Vendored / build directories pulled in during training ---
/llama.cpp/
/unsloth_compiled_cache/
wandb/

# Downloaded third-party binaries (llama.cpp release builds, etc.).
# Reproduced by the download step in docs/EVAL_METHODOLOGY.md, never committed.
/vendor/

# --- Evaluation output ---
# results/*_summary.json IS tracked: it is the published record of a run.
# The per-generation JSONL and raw console logs are not.
results/*_generations.jsonl
*.log

# --- Caches ---
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Local tool state ---
.claude/settings.local.json
.nlcli_wizard/
history.json
.env
.env.local

# ---------------------------------------------------------------------------
# Private working notes — drafts, session logs, personal/strategy material.
# notes/PROGRESS.md is the ONE tracked file in notes/ (see negation below).
# ---------------------------------------------------------------------------
notes/*
!notes/PROGRESS.md

docs/AGENT_INSTRUCTIONS.md
docs/CLAUDE_PROJECT_CONTEXT.md
docs/COMMUNITY_ENGAGEMENT_PLAN.md
docs/BLOG_CONTENT.md
docs/GITHUB_DESCRIPTIONS.md
docs/GITHUB_ISSUES_TEMPLATE.md
docs/PRE_PUSH_CHECKLIST.md
docs/adversary.md
docs/self.md
docs/01 new plan.md
docs/4B results.md
docs/This is brilliant.md
docs/NEXT_STEPS_DOCKER.md
docs/VENVY_AUDIT_REPORT.md
docs/DATASET_GENERATION_REPORT.md
